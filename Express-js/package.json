{
  "name": "cl-api",
  "version": "1.0.0",
  "description": "API Repos",
  "main": "index.js",
  "repository": "git@github.com:project/cl-api.git",
  "author": "Sanjiv",
  "license": "MIT",
  "scripts": {
    "db:migrate:seed": "sequelize db:migrate && sequelize db:seed:all && sequelize db:seed:all --seeders-path scripts/seeders",
    "test": "node ./node_modules/mocha/bin/mocha --timeout 20000",
    "unitTest": "export NODE_ENV=test && mocha ./test/unitTest/caseInfo/agreement/createOrEditAgreement.js  --timeout 99999",
    "coverage": "export NODE_ENV=test && nyc --clean --reporter=html mocha ./test/unitTest --recursive --timeout 99999",
    "test:statementSuite": "node test/runners/StatementAndPayment.js",
    "quotationUnitTest": "export NODE_ENV=test && mocha ./test/unitTest/App/quotation/quotationUnitTest.js  --timeout 99999",
    "quotationAgreementUnitTest": "export NODE_ENV=test &&  mocha ./test/unitTest/App/agreement  --timeout 99999",
    "quotationItemUnitTest": "export NODE_ENV=test && mocha ./test/unitTest/App/quotation/agreementItem.js  --timeout 99999",
    "test:runFile": "TEST_MODE=single node test/runners/StatementAndPayment.js",
    "dev": "nodemon index.js",
    "start": "nodemon index.js",
    "lint": "NODE_ENV=development eslint .; exit 0",
    "lint-fix": "NODE_ENV=development eslint . --fix; exit 0",
    "console": "node --experimental-repl-await",
    "worker:docusign": "node ./workers/docuSignWorker",
    "startDocker": "docker start mssql",
    "re-seed-specs": "node re-seed.js"
  },
  "dependencies": {
    "@azure/service-bus": "^1.1.9",
    "@azure/storage-blob": "^12.1.1",
    "@hapi/joi": "^15.0.3",
    "@newrelic/winston-enricher": "^1.0.0",
    "@ringcentral/sdk": "^4.3.0",
    "activedirectory2": "^1.2.7",
    "adm-zip": "^0.5.5",
    "async": "^2.6.1",
    "azure-storage": "^2.10.3",
    "bluebird": "^3.5.3",
    "body-parser-xml": "^1.1.0",
    "bull": "^3.7.0",
    "bull-arena": "^2.8.3",
    "chai-http": "^4.2.0",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csvtojson": "^2.0.10",
    "docusign-esign": "^5.0.2",
    "dotenv": "^6.1.0",
    "ejs": "^3.1.5",
    "elasticsearch": "^15.2.0",
    "express": "^4.16.4",
    "https": "^1.0.0",
    "istanbul": "^0.4.5",
    "jsdoc": "^3.6.3",
    "json2csv": "^4.3.1",
    "jsonwebtoken": "^8.3.0",
    "ldapjs": "^1.0.2",
    "lodash": "^4.17.15",
    "mocha-ci-reporter": "^1.0.1",
    "moment": "^2.22.2",
    "moment-range": "^4.0.2",
    "moment-timezone": "^0.5.31",
    "multer": "^1.4.2",
    "newrelic": "^7.0.1",
    "nock": "^10.0.1",
    "node-async": "0.0.1",
    "node-schedule": "^1.3.1",
    "node-xlsx": "^0.15.0",
    "nodejs-nodemailer-outlook": "^1.2.4",
    "nodemon": "^1.18.6",
    "passport": "^0.4.0",
    "passport-ldapauth": "^2.1.0",
    "pm2-logrotate": "^2.7.0",
    "redis": "^3.0.2",
    "request": "^2.88.0",
    "request-promise": "^4.2.2",
    "rollbar": "^2.5.2",
    "sequelize": "^5.22.2",
    "sequelize-cli": "^5.5.0",
    "stripe": "^7.10.0",
    "tedious": "^6.2.0",
    "underscore": "^1.9.1",
    "uuid": "^8.3.2",
    "winston": "^3.1.0",
    "winston-daily-rotate-file": "^3.5.1",
    "wkhtmltopdf": "^0.3.4",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "eslint": "^5.16.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-formatter-pretty": "^2.1.1",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-node": "^8.0.0",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "faker": "^4.1.0",
    "husky": "^2.3.0",
    "lint-staged": "^8.1.7",
    "mocha": "^5.2.0",
    "nyc": "^15.1.0",
    "prettier": "^1.17.1",
    "sinon": "^7.2.7"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint",
      "git add"
    ],
    "{*.json,.{eslintrc,prettierrc}}": [
      "git add"
    ],
    "*.{yml,md}": [
      "git add"
    ]
  }
}
